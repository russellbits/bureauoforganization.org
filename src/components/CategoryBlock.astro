---
interface Props {
  category: {
    name: string;
    url?: string;
    links: Array<{
      label: string;
      url: string;
      desc?: string;
    }>;
  };
}

const { category } = Astro.props;
---

<div>
  <h2>
    <a href={category.url}>{category.name}</a>
  </h2>

  <ul class="link-list">
    {category.links.map((link) => (
      <li>
        <a href={link.url} target={link.url.startsWith('http') ? "_blank" : "_self"}>
          {link.label}
        </a>
        {link.desc && <p>{link.desc}</p>}
      </li>
    ))}
  </ul>
</div>

<style>
  h2 a {
    color: #1e293b;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
  }

  .link-list {
    list-style-type: bullet;
    padding: 0;
    padding-left: 1.5rem;
    margin: 0;
  }
  .link-list li::marker {
      font-weight: bold;
    }
  .link-list li {
      padding-left: 0.25rem;
    margin-bottom: 0;
  }

  .link-list a {
    color: #2563eb;
    text-decoration: none;
  }

  .link-list a:hover {
    text-decoration: underline;
  }

  .link-list p {
      font-size: 0.8em;
      margin-top: 0;
  }
</style>
