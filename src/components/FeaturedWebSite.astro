---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  site_slug: string;
}

const { site_slug } = Astro.props;

// Fetch the specific item from the collection by its filename ID
const item = await getEntry('featured_sites', site_slug);

if (!item) {
  throw new Error(`Featured site "${site_slug}" not found in content collections.`);
}

const { label, description, url, tags } = item.data;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/web-site-previews/*.{jpeg,jpg,png,gif}');
const imagePath = `/src/assets/web-site-previews/${site_slug}.jpg`;

if (!images[imagePath]) {
  throw new Error(`Image "${imagePath}" not found.`);
}
---

<div class="featured-site-card">
    <Image src={images[imagePath]()} alt={label} width={200} />
    <h3><a href={url}>{label}</a></h3>
    <p>{description}</p>
    <div class="tags">
        {tags && tags.map(tag => (
          <span class="tag">
            <a href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}>{tag}</a>
          </span>
        ))}
      </div>
</div>

<style>
/* Using boexs, but this is useful for the future
.tag:not(:last-child)::after {
  content: ", ";
}
*/

.tag {
    display: inline-block;
    color: white;
    background-color: purple;
    padding: 6px;
    margin: 3px;
}

.tag a {
    color: white;
    text-decoration: none;
}

.featured-site-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.featured-site-card img {
    max-width: 200px;
    border: 3px solid purple;
}
</style>
