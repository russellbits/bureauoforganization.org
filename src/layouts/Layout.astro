---
import TippyTopNav from '@components/TippyTopNav.astro';
import TopNav from '@components/TopNav.astro';
import SubMenu from '@components/SubMenu.astro';
import MidMenu from '@components/MidMenu.astro';
import HeaderImageMap from '@components/HeaderImageMap.astro';
import Footer from '@components/Footer.astro';
import { SITE_INFO } from "@scripts/bureau_config.js";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Generated by https://favicongenerator.io -->
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
		<link rel="icon" href="/favicon.ico">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
		<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)">
		<link rel="stylesheet" href="/styles/house.css" />
		<meta name="generator" content={Astro.generator} />
		<title>{SITE_INFO.title}</title>
		<meta name="description" content={SITE_INFO.description} />
        <!-- The hook for articles to generate Open Graph previews -->
        <slot name="head" />
        <!-- HTMX -->
        <script src="https://unpkg.com/htmx.org@2.0.10"></script>
        <!-- Dev aid: draws every <area> in every <img usemap> on the page as a
             translucent orange overlay. Kept off by `image_map: 0` in
             @scripts/bureau_config.js; flip that to 1 to enable it everywhere.
             Import it in any layout or component. -->
        <script>
            import '@scripts/imagemap_overlay.js';
        </script>
	</head>
	<body>
	<TippyTopNav />
	<TopNav />
	<HeaderImageMap />
	<SubMenu />
	<MidMenu />
	<slot />
	<Footer />
	</body>
</html>
