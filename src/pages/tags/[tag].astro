---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import FeaturedWebSite from '@components/FeaturedWebSite.astro'; // Adjust import path if needed

export async function getStaticPaths() {
  const allSites = await getCollection('featured_sites');

  // Collect all unique tags
  const allTags = new Set<string>();
  allSites.forEach(site => {
    if (site.data.tags) {
      site.data.tags.forEach(tag => allTags.add(tag));
    }
  });

  // Pass filtered and sorted sites directly via props
  return Array.from(allTags).map(tag => {
    const sitesWithTag = allSites
      .filter(site => site.data.tags && site.data.tags.includes(tag))
      .sort((a, b) => a.data.label.localeCompare(b.data.label));

    return {
      params: { tag },
      props: { tag, sites: sitesWithTag }
    };
  });
}

const { tag, sites } = Astro.props;
---

<Layout>
    <h1>Featured Sites with Tag: {tag}</h1>
    <main id="masonry-grid">
    {sites.length > 0 ? (
        <div class="card">
        {sites.map(site => (
          <FeaturedWebSite site_slug={site.id || site.slug} />
        ))}
        </div>
    ) : (
      <p>No featured sites found with the tag: {tag}</p>
    )}
  </main>
</Layout>

<style>
main {
    min-height: 100vh;
}
</style>

<script>
import Masonry from 'masonry-layout';

function initMasonry() {
  const grid = document.getElementById('masonry-grid');
  if (!grid) return;

  const masonry = new Masonry(grid, {
    itemSelector: '.card',
    columnWidth: 250,
    gutter: 30,
    fitWidth: true
  });

  // Initial layout
  masonry.layout();

  // Fix 1: Trigger layout after all images load
  const images = grid.querySelectorAll('img');
  images.forEach(img => {
    if (img.complete) return;
    img.addEventListener('load', () => masonry.layout());
  });

  // Fix 2: Trigger layout after custom web fonts finish rendering
  if ('fonts' in document) {
    document.fonts.ready.then(() => masonry.layout());
  }
}

initMasonry();
document.addEventListener('astro:page-load', initMasonry);
</script>
